# Application
APP_NAME="AI Matic - Personalized Content Generation"
APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=*

# Provider selection — change these to switch backends without code changes
# Text-to-Image: openai | gemini | titan
TTI_MODEL=openai
# Text-to-Video: sora | veo | nova_reel
TTV_MODEL=sora

# ─── OpenAI (ChatGPT / DALL-E / Sora) ─────────────────────────────────────────
# Supports: gpt-image-1, dall-e-3, chatgpt-image-latest
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-..."
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_VIDEO_MODEL=sora-2-pro

# ─── Google Cloud / DeepMind ─────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY="AIza..."
GOOGLE_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation
GOOGLE_VIDEO_MODEL=veo-3.1-generate-preview

# ─── AWS ─────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."
AWS_REGION="us-east-1"
AWS_TITAN_MODEL_ID=amazon.titan-image-generator-v2:0
AWS_NOVA_REEL_MODEL_ID=amazon.nova-reel-v1:0

# ─── Video generation polling ─────────────────────────────────────────────────
VIDEO_POLL_INTERVAL_SECONDS=5.0
VIDEO_POLL_TIMEOUT_SECONDS=600
